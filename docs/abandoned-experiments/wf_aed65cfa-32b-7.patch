+/* ---- SHARED TREE WALKER ---- */
+// Visits every leaf node that has a .code and .term (spec items).
+// Traverses .topics, .subtopics, .items arrays and plain objects recursively.
+function walkDataTree(obj, visitor) {
+  if (!obj || typeof obj !== 'object') return;
+  if (obj.code && obj.term) { visitor(obj); return; }
+  if (Array.isArray(obj)) { obj.forEach(i => walkDataTree(i, visitor)); return; }
+  if (obj.topics)    obj.topics.forEach(t    => walkDataTree(t, visitor));
+  if (obj.subtopics) obj.subtopics.forEach(s  => walkDataTree(s, visitor));
+  if (obj.items)     obj.items.forEach(i      => walkDataTree(i, visitor));
+}
